{
  "protocol": "tp-hybrid-ws-p0",
  "case_id": "TC-A1",
  "mode": "interactive",
  "doc": "外置人工闸门声明示例（内容取自 TC-A1 单方法全流程，真机人工验收使用）。gate_id 由被测 Swift 用例发出的 step_reached 帧决定，不是平台内建闭集——换用例时换声明文件，驱动不内置闸门知识。字段名与 core hybrid_plan.VerdictField/VerdictForm 逐字一致；kind 闭集 boolean|choice|text 与 VerdictFieldKind 对齐。本文件不含 auto_values，禁止用于 --structural（驱动会 fail-loud）。",
  "gates": [
    {
      "gate_id": "g-lock",
      "order": 1,
      "timeout_hint": 120,
      "prompt": "闸门 1/3：TC-A1 段 A 排钟后已手动锁屏。请确认锁屏动作完成、一次性闹钟在系统侧继续武装（y 确认 / n  reject）。",
      "verdict_form": {
        "type": "acknowledge",
        "fields": [],
        "require_evidence": false
      }
    },
    {
      "gate_id": "g-sidebutton",
      "order": 2,
      "timeout_hint": 240,
      "prompt": "闸门 2/3：120s 响铃窗口内闹钟已触发，侧边键处置动作已完成。请确认你实际执行了侧边键操作并观察到响铃/静音表现（y / n）。",
      "verdict_form": {
        "type": "acknowledge",
        "fields": [],
        "require_evidence": false
      }
    },
    {
      "gate_id": "g-sensory",
      "order": 3,
      "timeout_hint": 240,
      "prompt": "闸门 3/3：感官裁决。如实记录听感/触感与置信度；任一提示处可输入 /reject 整闸退回。备注可留空。",
      "verdict_form": {
        "type": "verdict",
        "require_evidence": true,
        "fields": [
          {
            "key": "ringtone_heard",
            "label": "是否听到铃声",
            "kind": "boolean",
            "required": true
          },
          {
            "key": "vibration_felt",
            "label": "是否感到震动",
            "kind": "boolean",
            "required": true
          },
          {
            "key": "confidence",
            "label": "裁决置信度",
            "kind": "choice",
            "options": ["high", "medium", "low"],
            "required": true
          },
          {
            "key": "note",
            "label": "备注（可选）",
            "kind": "text",
            "required": false
          }
        ]
      }
    }
  ]
}
