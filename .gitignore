# 知识库/向量库中间产物（可再生成）
# 锚定具体运行时目录：packages/.../testpilot_adapters/store/ 是源码包，必须入库
/store/
/subsystems/store/
*.npz
*.npy
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db

# 模型缓存（首次运行自动下载，数据不出本机）
.models/

# 前端工程依赖与构建产物（S1.5 web/，可由 scripts/build_web.sh 再生成）
/subsystems/web/node_modules/
/subsystems/web/.next/
/subsystems/web/out/
# tsc --noEmit 增量编译信息（incremental 构建副产物，每次类型检查自动再生成）
/subsystems/web/tsconfig.tsbuildinfo

# 评测/运行临时产物（S1.6 评测报告 JSON/Markdown 落 subsystems/out/eval/）
results/
/subsystems/out/
*.xcresult
screenshots/
videos/

# 跨 Agent 接力工作态（纯本地）
.agent-handoff/

# Claude Code 本机个人设置（含本地权限许可，不随仓共享；.claude/ 下其余共享配置仍可入库）
.claude/settings.local.json

# 编辑器
.obsidian/
.vscode/
